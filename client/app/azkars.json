  "categories": [
    {
      "id": "morning",
      "translations": {
        "عربي": "أذكار الصباح",
        "english": "Morning Azkar",
        "кыргыз": "Таңкы зикир",
        "français": "Azkar du matin",
        "español": "Azkar de la mañana"
      },
      "azkars": [
        {
          "id": "morning_1",
          "count": 1,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "أَعُوذُ بِاللهِ مِنْ الشَّيْطَانِ الرَّجِيمِ",
              "translations": {
                "english": "I seek refuge in Allah from the accursed devil.",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 2,
              "arabic": "اللّهُ لاَ إِلَـهَ إِلاَّ هُوَ الْحَيُّ الْقَيُّومُ",
              "translations": {
                "english": "Allah! There is no god except Him, the Ever-Living, All-Sustaining.",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 3,
              "arabic": "لاَ تَأْخُذُهُ سِنَةٌ وَلاَ نَوْمٌ",
              "translations": {
                "english": "Neither drowsiness nor sleep overtakes Him.",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 4,
              "arabic": "لَّهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الأَرْضِ",
              "translations": {
                "english": "To Him belongs whatever is in the heavens and whatever is on the earth.",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 5,
              "arabic": "مَن ذَا الَّذِي يَشْفَعُ عِنْدَهُ إِلاَّ بِإِذْنِهِ",
              "translations": {
                "english": "Who could possibly intercede with Him without His permission?",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 6,
              "arabic": "يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ",
              "translations": {
                "english": "He fully knows what is ahead of them and what is behind them.",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 7,
              "arabic": "وَلاَ يُحِيطُونَ بِشَيْءٍ مِّنْ عِلْمِهِ إِلاَّ بِمَا شَاء",
              "translations": {
                "english": "But no one can grasp any of His knowledge—except what He wills to reveal.",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 8,
              "arabic": "وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالأَرْضَ",
              "translations": {
                "english": "His Seat encompasses the heavens and the earth.",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 9,
              "arabic": "وَلاَ يَؤُودُهُ حِفْظُهُمَا",
              "translations": {
                "english": "And the preservation of both does not tire Him.",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 10,
              "arabic": "وَهُوَ الْعَلِيُّ الْعَظِيمُ",
              "translations": {
                "english": "For He is the Most High, the Greatest.",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_2",
          "count": 3,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "بِسْمِ اللهِ الرَّحْمنِ الرَّحِيم",
              "translations": {
                "english": "In the name of Allah, the Most Compassionate, the Most Merciful.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 2,
              "arabic": "قُلْ هُوَ ٱللَّهُ أَحَدٌ",
              "translations": {
                "english": "Say, ˹O Prophet,˺ 'He is Allah—One ˹and Indivisible˺.'",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 3,
              "arabic": "ٱللَّهُ ٱلصَّمَدُ",
              "translations": {
                "english": "Allah—the Sustainer ˹needed by all˺.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 4,
              "arabic": "لَمْ يَلِدْ وَلَمْ يُولَدْ",
              "translations": {
                "english": "He has never had offspring, nor was He born.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 5,
              "arabic": "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ",
              "translations": {
                "english": "And there is none comparable to Him.",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_3",
          "count": 3,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "بِسْمِ اللهِ الرَّحْمنِ الرَّحِيم",
              "translations": {
                "english": "In the name of Allah, the Most Compassionate, the Most Merciful.",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 2,
              "arabic": "قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ",
              "translations": {
                "english": "Say, 'I seek refuge in the Lord of the daybreak,'",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 3,
              "arabic": "مِن شَرِّ مَا خَلَقَ",
              "translations": {
                "english": "'from the evil of whatever He has created,'",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 4,
              "arabic": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
              "translations": {
                "english": "'and from the evil of the night when it grows dark,'",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 5,
              "arabic": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ",
              "translations": {
                "english": "'and from the evil of those who blow on knots,'",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 6,
              "arabic": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
              "translations": {
                "english": "'and from the evil of an envier when they envy.'",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_4",
          "count": 3,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "بِسْمِ اللهِ الرَّحْمنِ الرَّحِيم",
              "translations": {
                "english": "In the name of Allah, the Most Compassionate, the Most Merciful.",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 2,
              "arabic": "قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
              "translations": {
                "english": "Say, 'I seek refuge in the Lord of humankind,'",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 3,
              "arabic": "مَلِكِ ٱلنَّاسِ",
              "translations": {
                "english": "'the Master of humankind,'",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 4,
              "arabic": "إِلَٰهِ ٱلنَّاسِ",
              "translations": {
                "english": "'the God of humankind,'",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 5,
              "arabic": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ",
              "translations": {
                "english": "'from the evil of the lurking whisperer—',",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 6,
              "arabic": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ",
              "translations": {
                "english": "'who whispers into the hearts of humankind—',",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            },
            {
              "lineNumber": 7,
              "arabic": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ.",
              "translations": {
                "english": "'from among jinn and humankind.'",
                "кыргыз": "",
                "français": "",
                "español": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_5",
          "count": 1,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "أَصْبَحْنَا وَأَصْبَحَ الْمُلْكُ لِلَّهِ وَالْحَمْدُ لِلَّهِ",
              "translations": {
                "english": "We have entered a new day. With it, all dominion is Allah's. Praise is to Allah.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 2,
              "arabic": "لاَ إِلَهَ إلاَّ اللَّهُ وَحْدَهُ لاَ شَرِيكَ لَهُ",
              "translations": {
                "english": "None has the right to be worshiped but Allah alone. He has no partner.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 3,
              "arabic": "لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ",
              "translations": {
                "english": "To Allah belongs the dominion. To Him is the praise, and He is Able to do all things.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 4,
              "arabic": "رَبِّ أَسْأَلُكَ خَيْرَ مَا فِي هَذَا الْيَوْمِ وَخَيرَ مَا بَعْدَهُ",
              "translations": {
                "english": "My Lord, I ask You for the goodness of this day. I ask for the goodness of the days that come after it.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 5,
              "arabic": "وَأَعُوذُ بِكَ مِنْ شَرِّ مَا فِي هَذَا الْيَوْمِ وَشَرِّ مَا بَعْدَهُ",
              "translations": {
                "english": "I seek refuge in You from the evil of this day. I seek refuge from the evil of the days that come after it.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 6,
              "arabic": "رَبِّ أَعُوذُ بِكَ مِنَ الْكَسَلِ وَسُوءِ الْكِبَرِ",
              "translations": {
                "english": "My Lord, I seek refuge in You from laziness. I seek refuge from helpless old age.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 7,
              "arabic": "رَبِّ أَعُوذُ بِكَ مِنْ عَذَابٍ فِي النَّارِ وَعَذَابٍ فِي القَـبْرِ",
              "translations": {
                "english": "My Lord, I seek refuge in You from the punishment of Hell-fire. I seek refuge from the punishment of the grave.",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_6",
          "count": 3,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "اللّهُـمَّ بِكَ أَصْـبَحْنا وَبِكَ أَمْسَـينا",
              "translations": {
                "english": "O Allah, by You we enter the morning and by You we enter the evening.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 2,
              "arabic": "وَبِكَ نَحْـيا وَبِكَ نَمُـوتُ وَإِلَـيْكَ النُّـشُور",
              "translations": {
                "english": "By You we live and by You we die, and to You is the Final Return.",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_7",
          "count": 3,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "اللّهـمَّ أَنْتَ رَبِّـي لا إلهَ إلاّ أَنْتَ",
              "translations": {
                "english": "O Allah, You are my Lord, there is none worthy of worship but You.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 2,
              "arabic": "خَلَقْتَنـي وَأَنا عَبْـدُك",
              "translations": {
                "english": "You created me and I am your slave.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 3,
              "arabic": "وَأَنا عَلـى عَهْـدِكَ، وَوَعْـدِكَ ما اسْتَـطَعْـت",
              "translations": {
                "english": "I keep Your covenant and my pledge to You as far as I am able.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 4,
              "arabic": "أَعـوذُ بِكَ مِنْ شَـرِّ ما صَنَـعْت",
              "translations": {
                "english": "I seek refuge in You from the evil of what I have done.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 5,
              "arabic": "أَبـوءُ لَـكَ بِنِعْـمَتِـكَ عَلَـيَّ",
              "translations": {
                "english": "I admit to Your blessings upon me.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 6,
              "arabic": "وَأَبـوءُ بِذَنْـبي فَاغْفـِرْ لي",
              "translations": {
                "english": "I admit to my misdeeds. Forgive me.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 7,
              "arabic": "فَإِنَّـهُ لا يَغْـفِرُ الذُّنـوبَ إِلاّ أَنْتَ",
              "translations": {
                "english": "For there is none who may forgive sins but You.",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_8",
          "count": 4,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "اللّهُـمَّ إِنِّـي أَصْبَـحْتُ أَُشْـهِدُك",
              "translations": {
                "english": "O Allah, I have entered a new morning and call upon You.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 2,
              "arabic": "وَأُشْـهِدُ حَمَلَـةَ عَـرْشِـك",
              "translations": {
                "english": "I call upon the bearers of Your Throne.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 3,
              "arabic": "وَمَلائِكَتِك ، وَجَمـيعَ خَلْـقِك",
              "translations": {
                "english": "Your angels and all creation.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 4,
              "arabic": "أَنَّـكَ أَنْـتَ اللهُ لا إلهَ إلاّ أَنْـتَ وَحْـدَكَ لا شَريكَ لَـك",
              "translations": {
                "english": "To bear witness that surely You are Allah, there is none worthy of worship but You alone. You have no partners.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 5,
              "arabic": "وَأَنَّ ُ مُحَمّـداً عَبْـدُكَ وَرَسـولُـك",
              "translations": {
                "english": "And that Muhammad is Your slave and Your Messenger.",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_9",
          "count": 1,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "اللّهُـمَّ ما أَصْبَـَحَ بي مِـنْ نِعْـمَةٍ أَو بِأَحَـدٍ مِـنْ خَلْـقِكَ",
              "translations": {
                "english": "Allah, whatever blessing has been received by me in this morning or anyone of Your creation.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 2,
              "arabic": "فَمِـنْكَ وَحْـدَكَ لا شريكَ لَـكَ",
              "translations": {
                "english": "is from You alone, You have no partner.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 3,
              "arabic": "فَلَـكَ الْحَمْـدُ وَلَـكَ الشُّكْـرُ",
              "translations": {
                "english": "All praise is for You and thanks is to You.",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_10",
          "count": 3,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "اللّهُـمَّ عافِـني في بَدَنـي",
              "translations": {
                "english": "O Allah, make me healthy in my body.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 2,
              "arabic": "اللّهُـمَّ عافِـني في سَمْـعي",
              "translations": {
                "english": "O Allah, preserve for me my hearing.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 3,
              "arabic": "اللّهُـمَّ عافِـني في بَصَـري",
              "translations": {
                "english": "O Allah, preserve for me my sight.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 4,
              "arabic": "لا إلهَ إلاّ اللّه أَنْـتَ",
              "translations": {
                "english": "There is none worthy of worship but You.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 5,
              "arabic": "اللّهُـمَّ إِنّـي أَعـوذُبِكَ مِنَ الْكُـفرِ",
              "translations": {
                "english": "O Allah, I seek refuge in You from disbelief.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 6,
              "arabic": "وَالفَـقْرِ",
              "translations": {
                "english": "and poverty.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 7,
              "arabic": "وَأَعـوذُ بِكَ مِنْ عَذابِ القَـبْر",
              "translations": {
                "english": "and I seek refuge in You from the punishment of the grave.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 8,
              "arabic": "لا إلهَ إلاّ أَنْـتَ",
              "translations": {
                "english": "There is none worthy of worship but You.",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_11",
          "count": 7,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "حَسْبِـيَ اللّهُ لا إلهَ إلاّ هُوَ عَلَـيهِ تَوَكَّـلتُ وَهُوَ رَبُّ العَرْشِ العَظـيم",
              "translations": {
                "english": "Allah is sufficient for me. There is none worthy of worship but Him. I have placed my trust in Him. He is Lord of the Majestic Throne.",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_12",
          "count": 1,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "اللّهُـمَّ إِنِّـي أسْـأَلُـكَ العَـفْوَ وَالعـافِـيةَ في الدُّنْـيا وَالآخِـرَة",
              "translations": {
                "english": "O Allah, I seek Your forgiveness and Your protection in this world and the next.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 2,
              "arabic": "اللّهُـمَّ إِنِّـي أسْـأَلُـكَ العَـفْوَ وَالعـافِـيةَ في ديني وَدُنْـيايَ وَأهْـلي وَمالـي",
              "translations": {
                "english": "O Allah, I seek Your forgiveness and Your protection in my religion, in my worldly affairs, in my family, and in my wealth.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 3,
              "arabic": "اللّهُـمَّ اسْتُـرْ عـوْراتي وَآمِـنْ رَوْعاتـي",
              "translations": {
                "english": "O Allah, conceal my secrets and preserve me from anguish.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 4,
              "arabic": "اللّهُـمَّ احْفَظْـني مِن بَـينِ يَدَيَّ وَمِن خَلْفـي وَعَن يَمـيني وَعَن شِمـالي",
              "translations": {
                "english": "O Allah, guard me from what is in front of me and behind me, from my left and from my right.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 5,
              "arabic": "وَمِن فَوْقـي ، وَأَعـوذُ بِعَظَمَـتِكَ أَن أُغْـتالَ مِن تَحْتـي",
              "translations": {
                "english": "and from above me. I seek refuge in Your Greatness from being struck down from beneath me.",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_13",
          "count": 1,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "اللّهُـمَّ عالِـمَ الغَـيْبِ وَالشّـهادَةِ فاطِـرَ السّماواتِ وَالأرْضِ رَبَّ كـلِّ شَـيءٍ وَمَليـكَه",
              "translations": {
                "english": "O Allah, Knower of the unseen and the evident, Maker of the heavens and the earth, Lord of everything and its Possessor.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 2,
              "arabic": "أَشْهَـدُ أَنْ لا إِلـهَ إِلاّ أَنْت",
              "translations": {
                "english": "I bear witness that there is none worthy of worship but You.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 3,
              "arabic": "أَعـوذُ بِكَ مِن شَـرِّ نَفْسـي وَمِن شَـرِّ الشَّيْـطانِ وَشِـرْكِه",
              "translations": {
                "english": "I seek refuge in You from the evil of my soul, and from the evil of Satan and his helpers.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 4,
              "arabic": "وَأَنْ أَقْتَـرِفَ عَلـى نَفْسـي سوءاً أَوْ أَجُـرَّهُ إِلـى مُسْـلِم",
              "translations": {
                "english": "(I seek refuge in You) from bringing evil upon my soul and from harming any Muslim.",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_14",
          "count": 3,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "بِسـمِ اللهِ الذي لا يَضُـرُّ مَعَ اسمِـهِ شَيءٌ في الأرْضِ وَلا في السّمـاءِ وَهـوَ السّمـيعُ العَلـيم",
              "translations": {
                "english": "In the Name of Allah, Who with His Name nothing can cause harm in the earth nor in the heavens, and He is the All-Hearing, the All-Knowing.",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_15",
          "count": 3,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "رَضِيتُ بِاللهِ ربا وَبِالإِسْلَامِ دِينًا وَبُمُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمْ نَبياً",
              "translations": {
                "english": "I am pleased with Allah as my Lord, with Islam as my religion, and with Muhammad - Peace and Blessings of Allah be upon him – as my Prophet.",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_16",
          "count": 3,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "سُبْحـانَ اللهِ وَبِحَمْـدِهِ عَدَدَ خَلْـقِه",
              "translations": {
                "english": "Glory is to Allah and praise is to Him, by the multitude of His creation.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 2,
              "arabic": "وَرِضـا نَفْسِـه",
              "translations": {
                "english": "by His Pleasure.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 3,
              "arabic": "وَزِنَـةَ عَـرْشِـه",
              "translations": {
                "english": "by the weight of His Throne.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 4,
              "arabic": "وَمِـدادَ كَلِمـاتِـه",
              "translations": {
                "english": "and by the extent of His Words.",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_17",
          "count": 100,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "سُبْحـانَ اللهِ وَبِحَمْـدِهِ",
              "translations": {
                "english": "Glory is to Allah and praise is to Him.",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_18",
          "count": 3,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "يا حَـيُّ يا قَيّـومُ بِـرَحْمَـتِكِ أَسْتَـغـيث",
              "translations": {
                "english": "O Ever-Living One, O Eternal One, by Your mercy I call on You.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 2,
              "arabic": "أَصْلِـحْ لي شَـأْنـي كُلَّـهُ",
              "translations": {
                "english": "to set right all my affairs.",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 3,
              "arabic": "وَلا تَكِلـني إِلى نَفْـسي طَـرْفَةَ عَـينٍ",
              "translations": {
                "english": "Do not place me in charge of my soul even for the blinking of an eye.",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_19",
          "count": 100,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "لا إلهَ إلاّ اللّهُ وحْـدَهُ لا شَـريكَ لهُ",
              "translations": {
                "english": "None has the right to be worshiped but Allah alone, Who has no partner",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 2,
              "arabic": "لهُ المُـلْكُ ولهُ الحَمْـدُ، وهُوَ على كُلّ شَيءٍ قَديرِ",
              "translations": {
                "english": "His is the dominion and His is the praise and He is Able to do all things",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_20",
          "count": 1,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "أَصْبَـحْـنا وَأَصْبَـحْ المُـلكُ للهِ رَبِّ العـالَمـين",
              "translations": {
                "english": "We have entered a new day and with it all the dominion which belongs to Allah, Lord of all that exists",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 2,
              "arabic": "اللّهُـمَّ إِنِّـي أسْـأَلُـكَ خَـيْرَ هـذا الـيَوْم",
              "translations": {
                "english": "O Allah, I ask You for the goodness of this day",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 3,
              "arabic": "فَـتْحَهُ ، وَنَصْـرَهُ ، وَنـورَهُ وَبَـرَكَتَـهُ ، وَهُـداهُ",
              "translations": {
                "english": "its victory, its help, its light, its blessings, and its guidance",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 4,
              "arabic": "وَأَعـوذُ بِـكَ مِـنْ شَـرِّ ما فـيهِ وَشَـرِّ ما بَعْـدَه",
              "translations": {
                "english": "I seek refuge in You from the evil that is in it, and from the evil that follows it.",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_21",
          "count": 1,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ عِلْماً نَافِعاً",
              "translations": {
                "english": "O Allah, I ask You for knowledge that is of benefit",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 2,
              "arabic": "وَرِزْقاً طَيِّباً",
              "translations": {
                "english": "a good provision",
                "кыргыз": ""
              }
            },
            {
              "lineNumber": 3,
              "arabic": "وَعَمَلاً مُتَقَبَّلاً",
              "translations": {
                "english": "and deeds that will be accepted",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_22",
          "count": 10,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "اللَّهُمَّ صَلِّ وَ سَلِّمْ عَلَى نَبِيِّنَا مُحَمَّدٍ",
              "translations": {
                "english": "O Allah, we ask for Your peace and blessings upon our Prophet Muhammad",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        },
        {
          "id": "morning_23",
          "count": 100,
          "lines": [
            {
              "lineNumber": 1,
              "arabic": "أَسْتَغْفِرُ اللهَ وَأَتُوْبُ إِلَيْهِ",
              "translations": {
                "english": "I seek the forgiveness of Allah and repent to Him",
                "кыргыз": ""
              }
            }
          ],
          "virtues": {
            "lines": []
          }
        }
      ]
    }
  ]
}
